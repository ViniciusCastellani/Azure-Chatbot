# =========================================================
# OPENROUTER (o "cérebro" do orquestrador / chatbot)
# =========================================================
OPENROUTER_API_KEY=coloque_sua_chave_aqui
OPENROUTER_MODEL=openrouter/free
# Opcional: exigido por alguns modelos gratuitos do OpenRouter
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Azure AI Orchestrator Chatbot

# =========================================================
# AZURE AI VISION (Computer Vision v3.2) -> reconhecimento de
# objetos, marcas, faces e descrição de imagens
# Recurso: visao-computacional-05-09-2026 | region: centralus
# =========================================================
AZURE_VISION_ENDPOINT=https://visao-computacional-05-09-2026.cognitiveservices.azure.com
AZURE_VISION_KEY=coloque_sua_chave_aqui

# =========================================================
# AZURE AI SPEECH -> Fast Transcription (Speech-to-Text) e
# Text-to-Speech
# Recurso regional | region: centralus
# (endpoint é montado a partir da region: https://<region>.api.cognitive.microsoft.com
#  e https://<region>.tts.speech.microsoft.com)
# =========================================================
AZURE_SPEECH_REGION=centralus
AZURE_SPEECH_KEY=coloque_sua_chave_aqui

# =========================================================
# AZURE AI LANGUAGE -> Análise de Sentimento (com Opinion
# Mining) e Reconhecimento de Entidades Nomeadas (NER)
# Recurso: servico-idioma-05-09-2026 | region: centralus
# =========================================================
AZURE_LANGUAGE_ENDPOINT=https://servico-idioma-05-09-2026.cognitiveservices.azure.com
AZURE_LANGUAGE_KEY=coloque_sua_chave_aqui

# =========================================================
# AZURE AI TRANSLATOR -> tradução de TEXTO (endpoint global,
# comum a qualquer recurso Translator; a região identifica a
# chave usada)
# =========================================================
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_KEY=coloque_sua_chave_aqui
AZURE_TRANSLATOR_REGION=centralus

# =========================================================
# AZURE AI TRANSLATOR -> Document Translation (tradução de
# ARQUIVOS inteiros: .docx, .pdf, .pptx, .xlsx, preservando o
# layout original)
# Recurso: tradutor-05-09-2026 | region: centralus
# =========================================================
AZURE_DOC_TRANSLATOR_ENDPOINT=https://tradutor-05-09-2026.cognitiveservices.azure.com
AZURE_DOC_TRANSLATOR_KEY=coloque_sua_chave_aqui

# =========================================================
# AZURE AI DOCUMENT INTELLIGENCE -> OCR / extração de layout
# de documentos (notas fiscais, contratos, etc.)
# Recurso: inteligencia-documentos-05-09-2026 | region: centralus
# =========================================================
AZURE_DOCINTEL_ENDPOINT=https://inteligencia-documentos-05-09-2026.cognitiveservices.azure.com
AZURE_DOCINTEL_KEY=coloque_sua_chave_aqui

PORT=3000
